# =============================================
# Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores de DEV
# =============================================

# ---- Turso (Base de datos) ----
TURSO_DATABASE_URL=libsql://<nombre-db>.turso.io
TURSO_AUTH_TOKEN=<token-generado-en-turso-dashboard>

# ---- JWT (sesiones) ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<48-bytes-hex>

# Clave maestra requerida para registrar nuevos usuarios desde /api/auth/register
# (registro privado para evitar spam — solo quien tenga esta clave puede crear cuentas)
NUXT_MASTER_KEY=<cualquier-string-secreto>

# ---- Cloudflare R2 (Media) ----
# Dominio público del bucket (custom domain conectado en R2 settings)
R2_MEDIA_DOMAIN=media-dev.tigrefy.tonomolla.com

# Secreto HMAC para firmar URLs de audio HLS (no aplica a imágenes públicas)
R2_SIGNING_SECRET=<cualquier-hex-largo>

# ID de la cuenta de Cloudflare (R2 → Overview → Account ID)
R2_ACCOUNT_ID=<32-char-hex>

# API token S3 del bucket (R2 → Manage R2 API Tokens → Create User Token)
# Permisos: Object Read & Write, scope: solo el bucket de este entorno
R2_MEDIA_ACCESS_KEY_ID=<access-key-id>
R2_MEDIA_SECRET_ACCESS_KEY=<secret-access-key>

# Nombre del bucket
R2_MEDIA_BUCKET=tigrefy-dev
